generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum RoleName {
  CUSTOMER
  COMPANY
  HOTEL
  ADMIN
  SUPER_ADMIN
}

enum CompanyType {
  CAR_RENTAL
  HOTEL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  BANNED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  PENDING
  CANCELLED
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  PAID
  FAILED
  CANCELLED
  EXPIRED
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
  LPG
  CNG
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
}

enum NotificationType {
  ACCOUNT_APPROVED
  ACCOUNT_REJECTED
  CAR_APPROVED
  CAR_REJECTED
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_EXPIRED
  NEW_REVIEW
  NEW_PAYMENT
  GENERAL
}

model Country {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  code      String    @unique
  flagUrl   String    @map("flag_url")
  currency  String
  dialCode  String    @map("dial_code")
  cities    City[]
  companies Company[]
  cars      Car[]
  rooms     Room[]
  users     User[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("countries")
}

model City {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  countryId String    @db.Uuid @map("country_id")
  country   Country   @relation(fields: [countryId], references: [id])
  companies Company[]
  cars      Car[]
  rooms     Room[]
  users     User[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([name, countryId])
  @@map("cities")
}

model Role {
  id          String       @id @default(uuid()) @db.Uuid
  name        RoleName     @unique
  description String?
  permissions Permission[] @relation("RolePermissions")
  users       User[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")

  @@map("roles")
}

model Permission {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  roles       Role[]    @relation("RolePermissions")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@map("permissions")
}

model User {
  id             String          @id @default(uuid()) @db.Uuid
  email          String          @unique
  phone          String          @unique
  passwordHash   String          @map("password_hash")
  roleId         String          @db.Uuid @map("role_id")
  role           Role            @relation(fields: [roleId], references: [id])
  status         ApprovalStatus  @default(PENDING)
  emailVerified  Boolean         @default(false) @map("email_verified")
  phoneVerified  Boolean         @default(false) @map("phone_verified")

  fullName       String?         @map("full_name")
  fatherName     String?         @map("father_name")
  cnicOrId       String?         @map("cnic_or_id")
  dateOfBirth    DateTime?       @map("date_of_birth")
  address        String?
  cityId         String?         @db.Uuid @map("city_id")
  city           City?           @relation(fields: [cityId], references: [id])
  countryId      String?         @db.Uuid @map("country_id")
  country        Country?        @relation(fields: [countryId], references: [id])
  emergencyName  String?         @map("emergency_name")
  emergencyPhone String?         @map("emergency_phone")

  company        Company?
  reviews        Review[]
  favorites      Favorite[]
  notifications  Notification[]
  adminLogs      AdminLog[]
  auditLogs      AuditLog[]      @relation("UserAuditLogs")
  activityLogs   ActivityLog[]
  supportTickets SupportTicket[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  deletedAt      DateTime?       @map("deleted_at")

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Company {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @unique @db.Uuid @map("user_id")
  user            User              @relation(fields: [userId], references: [id])
  name            String            @unique
  ownerName       String            @map("owner_name")
  cnicOrId        String            @map("cnic_or_id")
  contactNumber   String            @map("contact_number")
  whatsAppNumber  String            @map("whatsapp_number")
  email           String            @unique
  businessAddress String            @map("business_address")
  licenseNumber   String            @map("license_number")
  profilePicture  String?           @map("profile_picture")
  cityId          String            @db.Uuid @map("city_id")
  city            City              @relation(fields: [cityId], references: [id])
  countryId       String            @db.Uuid @map("country_id")
  country         Country           @relation(fields: [countryId], references: [id])
  status          ApprovalStatus    @default(PENDING)
  companyType     CompanyType       @default(CAR_RENTAL) @map("company_type")
  documents       CompanyDocument[]
  subscriptions   Subscription[]
  cars            Car[]
  rooms           Room[]
  reviews         Review[]
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")

  @@index([status])
  @@index([deletedAt])
  @@map("companies")
}

model CompanyDocument {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @db.Uuid @map("company_id")
  company   Company   @relation(fields: [companyId], references: [id])
  docType   String    @map("doc_type")
  fileUrl   String    @map("file_url")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("company_documents")
}

model Subscription {
  id           String             @id @default(uuid()) @db.Uuid
  companyId    String             @db.Uuid @map("company_id")
  company      Company            @relation(fields: [companyId], references: [id])
  planName     String             @default("Basic Plan") @map("plan_name")
  maxCars      Int                @default(10) @map("max_cars")
  price        Decimal            @db.Decimal(10, 2)
  durationDays Int                @default(30) @map("duration_days")
  features     String[]
  status       SubscriptionStatus @default(PENDING)
  startDate    DateTime?          @map("start_date")
  endDate      DateTime?          @map("end_date")
  payments     Payment[]
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  deletedAt    DateTime?          @map("deleted_at")

  @@index([companyId])
  @@index([status])
  @@map("subscriptions")
}

model Payment {
  id             String             @id @default(uuid()) @db.Uuid
  subscriptionId String             @db.Uuid @map("subscription_id")
  subscription   Subscription       @relation(fields: [subscriptionId], references: [id])
  amount         Decimal            @db.Decimal(10, 2)
  currency       String             @default("PKR")
  countryCode    String             @default("PK") @map("country_code")
  gateway        String
  provider       String             @default("mock")
  paymentMethod  String             @default("card") @map("payment_method")
  providerPaymentId String?         @map("provider_payment_id")
  accountDetails String?            @map("account_details")
  transactionId  String             @unique @map("transaction_id")
  checkoutUrl    String?            @map("checkout_url")
  returnUrl      String?            @map("return_url")
  receiptUrl     String?            @map("receipt_url")
  status         PaymentStatus      @default(PENDING)
  statusDetails  String?            @map("status_details")
  webhookEventId String?            @map("webhook_event_id")
  checkoutPayload Json?             @map("checkout_payload")
  providerResponse Json?            @map("provider_response")
  lastWebhookPayload Json?          @map("last_webhook_payload")
  paidAt         DateTime?          @map("paid_at")
  verifiedAt     DateTime?          @map("verified_at")
  verifiedBy     String?            @db.Uuid @map("verified_by")
  notes          String?
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  deletedAt      DateTime?          @map("deleted_at")

  @@index([subscriptionId])
  @@index([status])
  @@map("payments")
}

model BankDetails {
  id            String   @id @default("platform")
  bankName      String   @map("bank_name")
  accountNumber String   @map("account_number")
  accountName   String   @map("account_name")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("bank_details")
}

model Car {
  id              String           @id @default(uuid()) @db.Uuid
  companyId       String           @db.Uuid @map("company_id")
  company         Company          @relation(fields: [companyId], references: [id])
  countryId       String           @db.Uuid @map("country_id")
  country         Country          @relation(fields: [countryId], references: [id])
  cityId          String           @db.Uuid @map("city_id")
  city            City             @relation(fields: [cityId], references: [id])
  name            String
  brand           String
  model           String
  year            Int
  color           String
  regNumber       String           @map("registration_number")
  engineNumber    String           @map("engine_number")
  mileage         Int
  fuelType        FuelType         @map("fuel_type")
  seatingCapacity Int              @map("seating_capacity")
  transmission    TransmissionType
  description     String
  features        String[]
  status          ApprovalStatus   @default(PENDING)
  images          CarImage[]
  documents       CarDocument[]
  favorites       Favorite[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")

  @@index([companyId])
  @@index([countryId])
  @@index([cityId])
  @@index([status])
  @@index([deletedAt])
  @@map("cars")
}

model CarImage {
  id        String    @id @default(uuid()) @db.Uuid
  carId     String    @db.Uuid @map("car_id")
  car       Car       @relation(fields: [carId], references: [id])
  imageUrl  String    @map("image_url")
  imageType String    @map("image_type")
  isPrimary Boolean   @default(false) @map("is_primary")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("car_images")
}

model CarDocument {
  id        String    @id @default(uuid()) @db.Uuid
  carId     String    @db.Uuid @map("car_id")
  car       Car       @relation(fields: [carId], references: [id])
  docType   String    @map("doc_type")
  fileUrl   String    @map("file_url")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("car_documents")
}

model Review {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @db.Uuid @map("company_id")
  company   Company   @relation(fields: [companyId], references: [id])
  userId    String    @db.Uuid @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  rating    Int
  comment   String
  isVisible Boolean   @default(true) @map("is_visible")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([companyId])
  @@index([userId])
  @@index([isVisible])
  @@map("reviews")
}

model Favorite {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  carId     String    @db.Uuid @map("car_id")
  car       Car       @relation(fields: [carId], references: [id])
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([userId, carId])
  @@map("favorites")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid @map("user_id")
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  message   String
  metadata  Json?
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")
  deletedAt DateTime?        @map("deleted_at")

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model OtpVerification {
  id        String    @id @default(uuid()) @db.Uuid
  email     String?
  phone     String?
  code      String
  purpose   String    @default("VERIFY")
  used      Boolean   @default(false)
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("otp_verifications")
}

model AdminLog {
  id        String   @id @default(uuid()) @db.Uuid
  adminId   String   @db.Uuid @map("admin_id")
  admin     User     @relation(fields: [adminId], references: [id])
  action    String
  details   String
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admin_logs")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid @map("user_id")
  user      User?    @relation("UserAuditLogs", fields: [userId], references: [id])
  action    String
  resource  String?
  resourceId String? @map("resource_id")
  details   String
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model ActivityLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  activity  String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("activity_logs")
}

model SupportTicket {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid @map("user_id")
  user        User      @relation(fields: [userId], references: [id])
  subject     String
  description String
  status      String    @default("OPEN")
  priority    String    @default("MEDIUM")
  response    String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@map("support_tickets")
}

model Room {
  id              String           @id @default(uuid()) @db.Uuid
  companyId       String           @db.Uuid @map("company_id")
  company         Company          @relation(fields: [companyId], references: [id])
  countryId       String           @db.Uuid @map("country_id")
  country         Country          @relation(fields: [countryId], references: [id])
  cityId          String           @db.Uuid @map("city_id")
  city            City             @relation(fields: [cityId], references: [id])
  name            String
  roomType        String           @default("STANDARD")
  pricePerNight   Decimal          @db.Decimal(10, 2)
  capacity        Int              @default(2)
  floor           String?
  description     String
  amenities       String[]
  status          ApprovalStatus   @default(PENDING)
  images          RoomImage[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")

  @@index([companyId])
  @@index([countryId])
  @@index([cityId])
  @@index([status])
  @@index([deletedAt])
  @@map("rooms")
}

model RoomImage {
  id        String    @id @default(uuid()) @db.Uuid
  roomId    String    @db.Uuid @map("room_id")
  room      Room      @relation(fields: [roomId], references: [id])
  imageUrl  String    @map("image_url")
  imageType String    @map("image_type")
  isPrimary Boolean   @default(false) @map("is_primary")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("room_images")
}
