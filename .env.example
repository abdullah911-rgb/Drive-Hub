# Copy to .env (or .env.local) and fill in values before running locally or deploying.

# PostgreSQL — Neon, Supabase, or Railway for production
#
# LOCAL:
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/nexttripy?schema=public"
#
# NEON (Vercel) — use the POOLED connection string.
# Remove channel_binding=require (Prisma does not support it).
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Required — generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret"

# Public app settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="NextTripy"

# Seeded on first `npm run db:seed`
ADMIN_EMAIL="admin@nexttripy.com"
ADMIN_PASSWORD="change-me-strong-password"
ADMIN_PHONE="+920000000000"

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Prefer port 587 (STARTTLS). Port 465 is often blocked on Vercel.
SMTP_HOST="mail.nexttripy.com"
SMTP_PORT="587"
SMTP_USER="info@nexttripy.com"
SMTP_PASS="your-smtp-password"
# One pair of quotes around the whole value (do not nest quotes around the name):
SMTP_FROM="NextTripy <info@nexttripy.com>"
