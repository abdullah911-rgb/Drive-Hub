# Copy to .env.local and fill in values before running locally or deploying.

# PostgreSQL — use Neon, Supabase, or Railway for production
#
# LOCAL development:
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/car_rental_db?schema=public"
#
# NEON (production on Vercel) — use the POOLED connection string from the Neon dashboard.
# IMPORTANT: Remove channel_binding=require — Prisma does NOT support it and will silently fail.
# Correct format:
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Required — generate with: openssl rand -base64 48
JWT_SECRET="jewcjoiwjlkwavnanwvnawjfklwlkfwlkefjwklf3io2u98y4788    y84587yifhuihfkjw"

# Public app settings
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NEXT_PUBLIC_APP_NAME="DriveHub Marketplace"

# Run once after deploy to create the first admin (npm run db:seed)
ADMIN_EMAIL="admin@drivehub.com"
ADMIN_PASSWORD="911259"
ADMIN_PHONE="+10000000000"

# ── Email Notifications (Gmail SMTP) ──────────────────────────────────────────
# Setup: myaccount.google.com → Security → 2-Step Verification → App Passwords
# Generate an App Password for "Mail" → paste the 16-char password below
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM='"DriveHub Marketplace" <your-gmail@gmail.com>'
