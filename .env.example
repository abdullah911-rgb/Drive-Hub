# Copy to .env.local and fill in values before running locally or deploying.

# PostgreSQL — use Neon, Supabase, or Railway for production
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/car_rental_db?schema=public"

# Required — generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Public app settings
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NEXT_PUBLIC_APP_NAME="DriveHub Marketplace"

# Run once after deploy to create the first admin (npm run db:seed)
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="ChangeThisSecurePassword123!"
ADMIN_PHONE="+10000000000"

# ── Email Notifications (Gmail SMTP) ──────────────────────────────────────────
# Setup: myaccount.google.com → Security → 2-Step Verification → App Passwords
# Generate an App Password for "Mail" → paste the 16-char password below
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM='"DriveHub Marketplace" <your-gmail@gmail.com>'
